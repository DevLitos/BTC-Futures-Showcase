# ============================================================
# BTC Runtime - local configuration example
# Copy values to a local environment file; never commit populated secrets.
# ============================================================

# =============================================================================
# TRADING MODE
# =============================================================================
MODE=backtest                   # live or backtest
TRADING_ENABLED=false           # Set true only after a live configuration review

# =============================================================================
# EXCHANGE CREDENTIALS
# =============================================================================
EXCHANGE=krakenfutures

# Kraken Futures (primary)
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# Binance (alternative)
# BINANCE_API_KEY=
# BINANCE_SECRET=

METRICS_PORT=8000               # Prometheus metrics
HEALTH_INTERVAL_SECONDS=15
HEALTH_MAX_INTERVAL_SECONDS=60
HEALTH_CB_FAILURE_THRESHOLD=3
HEALTH_CB_RECOVERY_SECONDS=30
WS_SYMBOL=PF_XBTUSD
REST_SYMBOL=BTC/USD:USD
HEALTH_SYMBOL=BTC/USD:USD
POSITION_SIZE_BTC=0.001
LOG_INTERVAL_SECONDS=10
LOG_EVERY_TICK=false
ENABLED_STRATEGIES=FVG_TREND,IFVG
CANDLE_INTERVALS=60,300
PRIMARY_INTERVAL=300
