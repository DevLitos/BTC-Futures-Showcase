# ============================================================
# DayTrader 2.1 - Example Environment Configuration
# Copy to .env.secrets and fill with your values
# ============================================================

# =============================================================================
# TRADING MODE
# =============================================================================
TRADING_MODE=PAPER              # LIVE, PAPER, or BACKTEST
DEMO_MODE=false                 # Run without API keys (testing only)

# =============================================================================
# EXCHANGE CREDENTIALS
# =============================================================================
EXCHANGE=krakenfutures

# Kraken Futures (primary)
KRAKEN_FUTURES_API_KEY=your_api_key_here
KRAKEN_FUTURES_SECRET=your_secret_here

# Binance (alternative)
# BINANCE_API_KEY=
# BINANCE_SECRET=

# =============================================================================
# TELEGRAM NOTIFICATIONS
# =============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# =============================================================================
# API CONFIGURATION (NEW - FastAPI)
# =============================================================================
# Port for REST API (runs as separate service)
API_PORT=8080

# API key for protected endpoints (X-API-Key header)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_secure_api_key_here

# Rate limiting (requests per minute per IP)
API_RATE_LIMIT=60

# CORS origins (comma-separated, or * for all)
API_CORS_ORIGINS=*

# =============================================================================
# SERVER PORTS (Bot internal)
# =============================================================================
METRICS_PORT=8000               # Prometheus metrics
HEALTH_PORT=8001                # K8s health probes (bot)

# =============================================================================
# PERSISTENCE
# =============================================================================
PERSISTENCE=parquet             # parquet or postgresql
# DATABASE_URL=postgresql://user:pass@host:5432/db

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=text                 # text for dev, json for production

# =============================================================================
# SAFETY LIMITS
# =============================================================================
MAX_POSITION_USD=10000
MAX_DAILY_TRADES=100
MAX_DAILY_LOSS_PCT=3.0
MAX_TIME_DRIFT_MS=500

# =============================================================================
# KILL SWITCH
# =============================================================================
TRADING_KILL_SWITCH=false       # Set to true to stop new trades

# =============================================================================
# DOCKER HOST MAPPING (for docker-compose)
# =============================================================================
# API_HOST_PORT=127.0.0.1:8080  # Where to expose API on host
# GRAFANA_PASSWORD=changeme
