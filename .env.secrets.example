# ============================================================
# BTC Runtime - local secrets example
# This file is a template only. Never commit a populated copy.
# ============================================================
#
# SEGURIDAD OBLIGATORIA:
#   chmod 600 .env.secrets
#   chown $USER:$USER .env.secrets
#
# NUNCA:
#   - Commitear a git (verificar .gitignore)
#   - Incluir en backups
#   - Copiar sin cifrar
#
# ============================================================

# =========================================================================
# TRADING MODE
# =========================================================================
MODE=live
TRADING_ENABLED=true

# =========================================================================
# KRAKEN FUTURES - CREDENCIALES
# =========================================================================
# Obtener en: https://futures.kraken.com/trade/settings/api
# Permisos requeridos: Query, Trade
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=
