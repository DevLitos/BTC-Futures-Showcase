- 6+ cooldown systems
- 4 session multiplier definitions
- Scattered bypass checks (displacement_bypass or expansion_mode)
- Duplicate CONSENSUS logic in RANGE/TRANSITION/TREND

ARCHITECTURE:
- ONE method for direction: get_effective_direction()
- ONE method for trading decision: should_trade()
- ONE method for bypass: should_bypass_filter()
- ONE method for size multiplier: get_size_multiplier()
"""

import logging
from dataclasses import dataclass, field
from datetime import datetime, timedelta
from enum import Enum
from typing import Optional, Dict, Any, Tuple, TYPE_CHECKING

if TYPE_CHECKING:
    from src.domain.trading.edge_state_manager import EdgeStateManager

logger = logging.getLogger(__name__)


class DirectionSource(Enum):
    """Where the trading direction came from."""
    EXPANSION_LOCK = 100      # Highest - locked direction from expansion
    DIRECTION_LOCK = 90       # Locked from displacement
    EDGE_ACTIVE = 80          # Active edge direction
    DISPLACEMENT = 70         # Displacement detected
    CONSENSUS = 60            # structural == active
    MOMENTUM = 50             # Active direction alone
    HTF_BIAS = 30             # Structural bias fallback
    NONE = 0                  # No direction


class RegimeMode(Enum):
    """Market regime for trading rules."""
    RANGE_EXTREME = "RANGE_EXTREME"      # At range extreme - trade reversals
    RANGE_MID = "RANGE_MID"              # Mid-range - need consensus
    TRANSITION = "TRANSITION"            # Transitioning - gradual size
    TREND = "TREND"                      # Trending - full size
    EXPANSION = "EXPANSION"              # Strong momentum - bypass filters


@dataclass
class DirectionDecision:
    """Result of direction calculation."""
    direction: Optional[str]           # 'LONG', 'SHORT', or None
    source: DirectionSource            # Where it came from
    confidence: float                  # 0.0 to 1.0
    reason: str = ""                   # Human-readable reason
    vetoed: bool = False               # True if forbidden
    veto_reason: str = ""              # Why vetoed
    
    @property
    def is_valid(self) -> bool:
        """True if we have a valid, non-vetoed direction."""
        return self.direction is not None and not self.vetoed
    
    def to_tags(self) -> Dict[str, Any]:
        """Convert to trade tags."""
        return {
            'direction': self.direction,
            'direction_source': self.source.name,
            'direction_confidence': self.confidence,
            'direction_vetoed': self.vetoed,
            'direction_veto_reason': self.veto_reason if self.vetoed else None,
        }


@dataclass
class TradeDecision:
    """Complete trading decision."""
    should_trade: bool = False
    direction: Optional[str] = None
    size_multiplier: float = 1.0
    regime: RegimeMode = RegimeMode.TREND
    reason: str = ""
    bypass_active: bool = False
    bypass_reason: str = ""
    tags: Dict[str, Any] = field(default_factory=dict)
    
    def to_tags(self) -> Dict[str, Any]:
        """Convert to trade tags."""
        tags = {
            'trade_decision': self.should_trade,
            'trade_direction': self.direction,
            'trade_size_mult': self.size_multiplier,
            'trade_regime': self.regime.value,
            'trade_reason': self.reason,
            'trade_bypass': self.bypass_active,
        }
        tags.update(self.tags)
        return tags


class UnifiedTradingIntelligence:
    """
    Single source of truth for ALL trading decisions.
    
    This class consolidates:
    - Direction determination
    - Regime detection
    - Filter bypass logic
    - Size multiplier calculation
    - Consensus validation
    """
    
    def __init__(self):
        # Direction state
        self._structural_bias: Optional[str] = None
        self._active_direction: Optional[str] = None
        self._forbidden_direction: Optional[str] = None
        
        # Momentum state
        self._displacement_bypass: bool = False
        self._strong_displacement: bool = False
        self._expansion_mode: bool = False
        self._expansion_direction: Optional[str] = None
        
        # Direction lock
        self._direction_lock: Optional[str] = None
        self._direction_lock_expires_at: Optional[datetime] = None
        
        # Regime state
        self._current_regime: RegimeMode = RegimeMode.TREND
        self._regime_score: float = 0.5
        
        # Price confirmation
        self._last_price_check_time: Optional[datetime] = None
        self._last_price_confirms: bool = True
        
        # Edge manager reference (set externally)
        self._edge_manager: Optional['EdgeStateManager'] = None
        
        # Logging control
        self._last_log_time: Optional[datetime] = None
        self._log_interval_seconds: int = 30
    
    def set_edge_manager(self, edge_manager: 'EdgeStateManager'):
        """Set reference to edge manager."""
        self._edge_manager = edge_manager
    
    # =========================================================================
    # STATE UPDATES - Called by trading_app to update state
    # =========================================================================
    
    def update_structural_bias(self, bias: Optional[str]):
        """Update HTF structural bias."""
        self._structural_bias = bias
    
    def update_active_direction(self, direction: Optional[str]):
        """Update momentum-based active direction."""
        self._active_direction = direction
    
    def update_forbidden_direction(self, direction: Optional[str]):
        """Update forbidden direction from invalidation."""
        self._forbidden_direction = direction
    
    def update_displacement_state(self, 
                                   displacement_bypass: bool,
                                   strong_displacement: bool = False):
        """Update displacement state."""
        self._displacement_bypass = displacement_bypass
        self._strong_displacement = strong_displacement
    
    def update_expansion_state(self,
                                expansion_mode: bool,
                                expansion_direction: Optional[str] = None):
        """Update expansion mode state."""
        self._expansion_mode = expansion_mode
        self._expansion_direction = expansion_direction
    
    def update_direction_lock(self, 
                               direction: Optional[str],
                               expires_at: Optional[datetime] = None):
        """Update direction lock."""
        self._direction_lock = direction
        self._direction_lock_expires_at = expires_at
    
    def update_regime(self, regime_score: float, trading_mode: str):
        """Update regime from trading_app calculations."""
        self._regime_score = regime_score
        
        # Map trading_mode string to RegimeMode
        mode_map = {
            'RANGE': RegimeMode.RANGE_MID,  # Will be refined by extreme check
            'TRANSITION': RegimeMode.TRANSITION,
            'TREND': RegimeMode.TREND,
        }
        self._current_regime = mode_map.get(trading_mode, RegimeMode.TREND)
        
        # Override to EXPANSION if momentum active
        if self.has_momentum_override:
            self._current_regime = RegimeMode.EXPANSION
    
    # =========================================================================
    # COMPUTED PROPERTIES
    # =========================================================================
    
    @property
    def has_momentum_override(self) -> bool:
        """
        Should we bypass regime filters due to strong momentum?
        
        UNIFIED: Replaces 6+ scattered checks of:
        self._displacement_bypass or self._expansion_mode
        """
        return (
            self._displacement_bypass or 
            self._expansion_mode or 
            self._strong_displacement
        )
    
    @property
    def has_direction_lock(self) -> bool:
        """Is direction currently locked?"""
        if not self._direction_lock:
            return False
        if self._direction_lock_expires_at:
            return datetime.now() < self._direction_lock_expires_at
        return True
    
    @property
    def locked_direction(self) -> Optional[str]:
        """Get locked direction if active."""
        return self._direction_lock if self.has_direction_lock else None
    
    # =========================================================================
    # DIRECTION DECISION
    # =========================================================================
    
    def get_effective_direction(self) -> DirectionDecision:
        """
        Get the SINGLE effective trading direction.
        
        REPLACES the chaos of checking multiple direction sources
        in different orders across the codebase.
        
        PRIORITY ORDER (highest to lowest):
        1. EXPANSION_LOCK - Expansion mode locks direction
        2. DIRECTION_LOCK - Displacement locked direction
        3. EDGE_ACTIVE - Active edge direction
        4. DISPLACEMENT - Displacement direction
        5. CONSENSUS - structural == active
        6. MOMENTUM - Active direction alone
        7. HTF_BIAS - Structural bias as fallback
        """
        direction: Optional[str] = None
        source = DirectionSource.NONE
        confidence = 0.0
        reason = ""
        
        # PRIORITY 1: Expansion mode (locked direction)
        if self._expansion_mode and self._expansion_direction:
            direction = self._expansion_direction
            source = DirectionSource.EXPANSION_LOCK
            confidence = 1.0
            reason = f"Expansion mode locked to {direction}"
        
        # PRIORITY 2: Direction lock from displacement
        elif self.has_direction_lock:
            direction = self._direction_lock
            source = DirectionSource.DIRECTION_LOCK
            confidence = 0.9
            reason = f"Direction locked to {direction}"
        
        # PRIORITY 3: Active edge direction
        elif self._edge_manager and self._edge_manager.current_bos:
            direction = self._edge_manager.current_bos.direction
            source = DirectionSource.EDGE_ACTIVE
            confidence = 0.8
            reason = f"Edge active: {direction}"
        
        # PRIORITY 4: Displacement direction
        elif self._displacement_bypass and self._active_direction:
            direction = self._active_direction
            source = DirectionSource.DISPLACEMENT
            confidence = 0.7
            reason = f"Displacement detected: {direction}"
        
        # PRIORITY 5: Consensus (structural == active)
        elif (self._structural_bias and self._active_direction and 
              self._structural_bias == self._active_direction):
            direction = self._structural_bias
            source = DirectionSource.CONSENSUS
            confidence = 0.6
            reason = f"Consensus: structural={self._structural_bias} == active={self._active_direction}"
        
        # PRIORITY 6: Active direction alone
        elif self._active_direction:
            direction = self._active_direction
            source = DirectionSource.MOMENTUM
            confidence = 0.5
            reason = f"Momentum: {direction}"
        
        # PRIORITY 7: Structural bias as fallback
        elif self._structural_bias:
            direction = self._structural_bias
            source = DirectionSource.HTF_BIAS
            confidence = 0.3
            reason = f"HTF bias: {direction}"
        
        # Check for veto (forbidden direction)
        vetoed = False
        veto_reason = ""
        
        if direction and self._forbidden_direction == direction:
            # Expansion mode bypasses veto
            if source == DirectionSource.EXPANSION_LOCK:
                pass  # No veto for expansion
            else:
                vetoed = True
                veto_reason = f"{direction} is forbidden by invalidation"
        
        return DirectionDecision(
            direction=direction,
            source=source,
            confidence=confidence,
            reason=reason,
            vetoed=vetoed,
            veto_reason=veto_reason
        )
    
    # =========================================================================
    # BYPASS DECISION
    # =========================================================================
    
    def should_bypass_filter(self, filter_name: str) -> Tuple[bool, str]:
        """
        Should we bypass a specific filter?
        
        UNIFIED: Replaces scattered bypass logic.
        
        Args:
            filter_name: 'RANGE_EXTREME', 'RANGE_MID', 'TRANSITION', 'CONSENSUS', etc.
        
        Returns:
            (should_bypass, reason)
        """
        # Momentum override bypasses ALL regime filters
        if self.has_momentum_override:
            bypass_type = 'EXPANSION' if self._expansion_mode else 'DISPLACEMENT'
            return True, f"{bypass_type} override active"
        
        # Direction lock bypasses direction conflicts
        if filter_name == 'DIRECTION_CONFLICT' and self.has_direction_lock:
            return True, f"Direction locked to {self._direction_lock}"
        
        return False, ''
    
    # =========================================================================
    # SIZE MULTIPLIER
    # =========================================================================
    
    def get_size_multiplier(self, 
                            regime_score: float = 0.5,
                            at_extreme: bool = False,
                            extremity: float = 0.0) -> float:
        """
        Get position size multiplier based on regime and conditions.
        
        UNIFIED: Replaces multiple size calculations scattered across code.
        
        Returns:
            Size multiplier (0.0 to 1.0)
        """
        # Base multiplier by regime
        if self._current_regime == RegimeMode.EXPANSION:
            # Strong momentum - higher size
            return 0.80
        
        elif self._current_regime == RegimeMode.TREND:
            # Trending - full base size
            return 1.0
        
        elif self._current_regime == RegimeMode.TRANSITION:
            # Transitioning - gradual size based on score
            # Score 0.35 → 50%, Score 0.50 → 70%
            progress = (regime_score - 0.35) / 0.15
            progress = max(0.0, min(1.0, progress))
            return 0.50 + (progress * 0.20)
        
        elif self._current_regime == RegimeMode.RANGE_EXTREME:
            # At extreme - size based on how extreme
            # 35% base + up to 25% more based on extremity
            return 0.35 + extremity * 0.25
        
        elif self._current_regime == RegimeMode.RANGE_MID:
            # Mid-range - conservative
            return 0.40
        
        return 0.50  # Default fallback
    
    # =========================================================================
    # COMPLETE TRADE DECISION
    # =========================================================================
    
    def get_trade_decision(self,
                           current_price: float,
                           candles_1m: list,
                           regime_score: float = 0.5,
                           at_extreme: bool = False,
                           extremity: float = 0.0,
                           market_time: Optional[datetime] = None) -> TradeDecision:
        """
        Get complete trading decision.
        
        UNIFIED: Single method that returns everything needed.
        
        This replaces:
        - RANGE_MID logic
        - TRANSITION logic
        - TREND logic
        - All the scattered consensus checks
        """
        # Update regime
        self.update_regime(regime_score, self._current_regime.value.split('_')[0])
        
        # Get direction
        direction_decision = self.get_effective_direction()
        
        # Check bypass
        bypass, bypass_reason = self.should_bypass_filter(self._current_regime.value)
        
        # Base decision
        decision = TradeDecision(
            direction=direction_decision.direction,
            regime=self._current_regime,
            bypass_active=bypass,
            bypass_reason=bypass_reason,
        )
        
        # If no valid direction, no trade
        if not direction_decision.is_valid:
            decision.should_trade = False
            decision.reason = direction_decision.veto_reason if direction_decision.vetoed else "No direction"
            return decision
        
        # If momentum override, trade
        if bypass:
            decision.should_trade = True
            decision.reason = bypass_reason
            decision.size_multiplier = self.get_size_multiplier(regime_score, at_extreme, extremity)
            return decision
        
        # Regime-specific rules
        if self._current_regime in (RegimeMode.RANGE_MID, RegimeMode.TRANSITION):
            # Need CONSENSUS or high confidence
            if direction_decision.source == DirectionSource.CONSENSUS or direction_decision.confidence >= 0.6:
                # Validate price confirms direction
                if direction_decision.direction is None:
                    decision.should_trade = False
                    decision.reason = "No direction"
                    return decision
                    
                price_confirms, confirm_reason = self._check_price_confirms(
                    direction_decision.direction, candles_1m
                )
                
                if not price_confirms:
                    decision.should_trade = False
                    decision.reason = f"Price contradicts: {confirm_reason}"
                    return decision
                
                decision.should_trade = True
                decision.reason = f"{direction_decision.source.name} confirmed by price"
            else:
                decision.should_trade = False
                decision.reason = f"Need consensus, got {direction_decision.source.name}"
        
        elif self._current_regime == RegimeMode.RANGE_EXTREME:
            # At extreme - check direction matches extreme
            decision.should_trade = True
            decision.reason = f"At extreme with {direction_decision.source.name}"
        
        elif self._current_regime == RegimeMode.TREND:
            # Trending - more permissive
            if direction_decision.confidence >= 0.5:
                decision.should_trade = True
                decision.reason = f"{direction_decision.source.name} in trend"
            else:
                decision.should_trade = False
                decision.reason = "Low confidence in trend"
        
        # Set size multiplier
        if decision.should_trade:
            decision.size_multiplier = self.get_size_multiplier(regime_score, at_extreme, extremity)
        
        # Add direction tags
        decision.tags.update(direction_decision.to_tags())
        
        return decision
    
    def _check_price_confirms(self, direction: str, candles_1m: list, 
                               lookback: int = 3) -> Tuple[bool, str]:
        """
        Check if recent price movement confirms direction.
        
        Args:
            direction: 'LONG' or 'SHORT'
            candles_1m: List of 1m candles
            lookback: How many candles to check
        
        Returns:
            (confirms, reason)
        """
        if not candles_1m or len(candles_1m) < lookback + 1:
            return True, "Not enough data"
        
        recent = candles_1m[-(lookback + 1):]
        price_start = recent[0]['close']
        price_end = recent[-1]['close']
        price_change_pct = (price_end - price_start) / price_start * 100
        
        # 0.25% move in 3 minutes is significant contradiction
        CONTRADICT_THRESHOLD = 0.25
        
        if direction == 'SHORT':
            if price_change_pct > CONTRADICT_THRESHOLD:
                return False, f"Price UP {price_change_pct:.2f}% contradicts SHORT"
            return True, f"Price confirms SHORT ({price_change_pct:.2f}%)"
        
        elif direction == 'LONG':
            if price_change_pct < -CONTRADICT_THRESHOLD:
                return False, f"Price DOWN {abs(price_change_pct):.2f}% contradicts LONG"
            return True, f"Price confirms LONG ({price_change_pct:.2f}%)"
        
        return True, "Unknown direction"
    
    # =========================================================================
    # LOGGING
    # =========================================================================
    
    def log_state(self, force: bool = False):
        """Log current state (rate limited)."""
        now = datetime.now()
        if not force and self._last_log_time:
            if (now - self._last_log_time).total_seconds() < self._log_interval_seconds:
                return
        
        self._last_log_time = now
        
        direction = self.get_effective_direction()
        
        logger.info(
            f"🧠 INTELLIGENCE: regime={self._current_regime.value} | "
            f"direction={direction.direction} ({direction.source.name}) | "
            f"confidence={direction.confidence:.0%} | "
            f"momentum_override={self.has_momentum_override}"
        )
